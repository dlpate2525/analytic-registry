// Native DAX metadata query, not a tenant inventory collector.
// Run against the supplied inventory semantic model with suitable query access.
// The result describes that model's columns. It does not return registry assets.
// If the managed read-only model rejects discovery, inspect its field list in
// a permitted custom report. Do not change the original managed model.
// https://learn.microsoft.com/en-us/dax/info-view-columns-function-dax
EVALUATE
    SELECTCOLUMNS(
        INFO.VIEW.COLUMNS(),
        "TableName", [Table],
        "ColumnName", [Name],
        "DataType", [DataType],
        "Description", [Description],
        "IsHidden", [IsHidden]
    )
ORDER BY [TableName], [ColumnName]

