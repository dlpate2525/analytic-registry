{
  "name": "analytic-registry-prototype",
  "private": true,
  "version": "1.0.0-prototype.1",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsx scripts/check.ts && tsx scripts/workflows.check.ts && tsx scripts/audit.check.ts",
    "prepare:release": "tsx scripts/generate-model.mjs && tsx scripts/prepare-release.mjs",
    "predev": "npm run prepare:release",
    "prebuild": "npm run prepare:release",
    "check:release": "tsx scripts/release.check.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "tsx": "^4.19.4"
  }
}
